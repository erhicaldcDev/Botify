{
    "name": "botify",
    "version": "1.2.0",
    "description": "Botify - OpenSource Discord Bot Creator",
    "main": "main.js",
    "author": {
        "name": "pqndr",
        "url": "https://github.com/erhicaldcDev",
        "email": "noreply@users.noreply.github.com"
    },
    "license": "MIT",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --dev",
        "postinstall": "electron-builder install-app-deps",
        "rebuild": "electron-builder install-app-deps",
        "build": "electron-builder",
        "package": "electron-packager . Botify --platform=win32 --arch=x64 --out=dist --overwrite --ignore=^/testbot",
        "dist": "electron-builder --publish never",
        "dist:win": "electron-builder --win --publish never",
        "dist:mac": "electron-builder --mac --publish never",
        "dist:linux": "electron-builder --linux --publish never"
    },
    "dependencies": {
        "better-sqlite3": "^9.6.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "electron": "^28.3.3",
        "electron-builder": "^24.13.3",
        "electron-packager": "^17.1.2"
    },
    "build": {
        "appId": "com.botify.creator",
        "productName": "Botify",
        "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
        "directories": {
            "buildResources": "resources",
            "output": "release"
        },
        "asar": false,
        "files": [
            "main.js",
            "preload.js",
            "package.json",
            "engine/**/*",
            "src/**/*",
            "plugins/**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "resources/icon.png"
        },
        "portable": {
            "artifactName": "${productName}-${version}-win-portable.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "artifactName": "${productName}-${version}-win-setup.${ext}"
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "category": "public.app-category.developer-tools",
            "icon": "resources/icon.png"
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "tar.gz",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "category": "Development",
            "icon": "resources/icon.png",
            "maintainer": "pqndr <noreply@users.noreply.github.com>"
        },
        "forceCodeSigning": false
    },
    "homepage": "https://github.com/erhicaldcDev/Botify",
    "repository": {
        "type": "git",
        "url": "https://github.com/erhicaldcDev/Botify.git"
    }
}
